{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-shipping" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-shipping" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <ul class="nav nav-tabs">
            <li class="nav-item"><a href="#tab-general" data-bs-toggle="tab" class="nav-link active">{{ text_general }}</a></li>
            <li class="nav-item"><a href="#tab-methods" data-bs-toggle="tab" class="nav-link">{{ text_methods }}</a></li>
          </ul>
          <div class="tab-content">
            <div id="tab-general" class="tab-pane active">
              <div class="row mb-3">
                <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
                <div class="col-sm-10">
                  <div class="form-check form-switch form-switch-lg">
                    <input type="hidden" name="shipping_geozone_status" value="0"/>
                    <input type="checkbox" name="shipping_geozone_status" value="1" id="input-status" class="form-check-input"{% if shipping_geozone_status %} checked{% endif %}/>
                  </div>
                </div>
              </div>
              <div class="row mb-3">
                <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
                <div class="col-sm-10">
                  <input type="text" name="shipping_geozone_sort_order" value="{{ shipping_geozone_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
                </div>
              </div>
            </div>
            <div id="tab-methods" class="tab-pane">
              <div id="methods">
                {% set row = 0 %}
                {% for method in shipping_geozone_methods %}
                  <div id="method-row-{{ row }}" class="border rounded p-3 mb-3">
                    <div class="row">
                      <div class="col-md-4">
                        {% for language in languages %}
                          <div class="mb-3 required">
                            <label for="input-name-{{ row }}-{{ language.language_id }}" class="form-label">{{ entry_name }}</label>
                            <div class="input-group">
                              <span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}"/></span>
                              <input type="text" name="shipping_geozone_method[{{ row }}][name][{{ language.language_id }}]" value="{{ method.name[language.language_id] }}" id="input-name-{{ row }}-{{ language.language_id }}" class="form-control"/>
                            </div>
                            <div id="error-name-{{ row }}-{{ language.language_id }}" class="invalid-feedback"></div>
                          </div>
                          <div class="mb-3">
                            <label for="input-instructions-{{ row }}-{{ language.language_id }}" class="form-label">{{ entry_instructions }}</label>
                            <div class="input-group">
                              <span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name }}" title="{{ language.name }}"/></span>
                              <textarea name="shipping_geozone_method[{{ row }}][instructions][{{ language.language_id }}]" id="input-instructions-{{ row }}-{{ language.language_id }}" rows="3" class="form-control">{{ method.instructions[language.language_id] }}</textarea>
                            </div>
                          </div>
                        {% endfor %}
                      </div>
                      <div class="col-md-4">
                        <div class="mb-3">
                          <label for="input-method-status-{{ row }}" class="form-label">{{ entry_status }}</label>
                          <select name="shipping_geozone_method[{{ row }}][status]" id="input-method-status-{{ row }}" class="form-select">
                            <option value="1"{% if method.status %} selected{% endif %}>{{ text_enabled }}</option>
                            <option value="0"{% if not method.status %} selected{% endif %}>{{ text_disabled }}</option>
                          </select>
                        </div>
                        <div class="mb-3">
                          <label for="input-total-{{ row }}" class="form-label">{{ entry_total }}</label>
                          <input type="text" name="shipping_geozone_method[{{ row }}][total]" value="{{ method.total }}" id="input-total-{{ row }}" class="form-control"/>
                          <div class="form-text">{{ help_total }}</div>
                          <div id="error-total-{{ row }}" class="invalid-feedback"></div>
                        </div>
                        <div class="mb-3">
                          <label for="input-geo-zone-{{ row }}" class="form-label">{{ entry_geo_zone }}</label>
                          <select name="shipping_geozone_method[{{ row }}][geo_zone_id]" id="input-geo-zone-{{ row }}" class="form-select">
                            <option value="0">{{ text_all_zones }}</option>
                            {% for geo_zone in geo_zones %}
                              <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == method.geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="col-md-3">
                        <div class="mb-3">
                          <label for="input-cost-{{ row }}" class="form-label">{{ entry_cost }}</label>
                          <input type="text" name="shipping_geozone_method[{{ row }}][cost]" value="{{ method.cost }}" id="input-cost-{{ row }}" class="form-control"/>
                          <div class="form-text">{{ help_cost }}</div>
                          <div id="error-cost-{{ row }}" class="invalid-feedback"></div>
                        </div>
                        <div class="mb-3">
                          <label for="input-tax-class-{{ row }}" class="form-label">{{ entry_tax_class }}</label>
                          <select name="shipping_geozone_method[{{ row }}][tax_class_id]" id="input-tax-class-{{ row }}" class="form-select">
                            <option value="0">{{ text_none }}</option>
                            {% for tax_class in tax_classes %}
                              <option value="{{ tax_class.tax_class_id }}"{% if tax_class.tax_class_id == method.tax_class_id %} selected{% endif %}>{{ tax_class.title }}</option>
                            {% endfor %}
                          </select>
                        </div>
                      </div>
                      <div class="col-md-1 text-end">
                        <button type="button" onclick="$('#method-row-{{ row }}').remove();" class="btn btn-danger" aria-label="{{ button_remove }}"><i class="fa-solid fa-minus-circle" aria-hidden="true"></i></button>
                      </div>
                    </div>
                  </div>
                  {% set row = row + 1 %}
                {% endfor %}
              </div>
              <div class="text-end">
                <button type="button" id="button-method-add" class="btn btn-primary" aria-label="{{ button_add }}"><i class="fa-solid fa-plus-circle" aria-hidden="true"></i></button>
              </div>
            </div>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript">
var method_row = {{ shipping_geozone_methods|length }};

$('#button-method-add').on('click', function () {
    var r = method_row++;
    var html = '<div id="method-row-' + r + '" class="border rounded p-3 mb-3"><div class="row"><div class="col-md-4">';
    {% for language in languages %}
    html += '<div class="mb-3 required"><label for="input-name-' + r + '-{{ language.language_id }}" class="form-label">{{ entry_name|escape('js') }}</label><div class="input-group"><span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name|escape('js') }}" title="{{ language.name|escape('js') }}"/></span><input type="text" name="shipping_geozone_method[' + r + '][name][{{ language.language_id }}]" value="" id="input-name-' + r + '-{{ language.language_id }}" class="form-control"/></div><div id="error-name-' + r + '-{{ language.language_id }}" class="invalid-feedback"></div></div>';
    html += '<div class="mb-3"><label for="input-instructions-' + r + '-{{ language.language_id }}" class="form-label">{{ entry_instructions|escape('js') }}</label><div class="input-group"><span class="input-group-text"><img src="{{ language.image }}" alt="{{ language.name|escape('js') }}" title="{{ language.name|escape('js') }}"/></span><textarea name="shipping_geozone_method[' + r + '][instructions][{{ language.language_id }}]" id="input-instructions-' + r + '-{{ language.language_id }}" rows="3" class="form-control"></textarea></div></div>';
    {% endfor %}
    html += '</div><div class="col-md-4">';
    html += '<div class="mb-3"><label for="input-method-status-' + r + '" class="form-label">{{ entry_status|escape('js') }}</label><select name="shipping_geozone_method[' + r + '][status]" id="input-method-status-' + r + '" class="form-select"><option value="1">{{ text_enabled|escape('js') }}</option><option value="0">{{ text_disabled|escape('js') }}</option></select></div>';
    html += '<div class="mb-3"><label for="input-total-' + r + '" class="form-label">{{ entry_total|escape('js') }}</label><input type="text" name="shipping_geozone_method[' + r + '][total]" value="0" id="input-total-' + r + '" class="form-control"/><div class="form-text">{{ help_total|escape('js') }}</div><div id="error-total-' + r + '" class="invalid-feedback"></div></div>';
    html += '<div class="mb-3"><label for="input-geo-zone-' + r + '" class="form-label">{{ entry_geo_zone|escape('js') }}</label><select name="shipping_geozone_method[' + r + '][geo_zone_id]" id="input-geo-zone-' + r + '" class="form-select"><option value="0">{{ text_all_zones|escape('js') }}</option>{% for geo_zone in geo_zones %}<option value="{{ geo_zone.geo_zone_id }}">{{ geo_zone.name|escape('js') }}</option>{% endfor %}</select></div>';
    html += '</div><div class="col-md-3">';
    html += '<div class="mb-3"><label for="input-cost-' + r + '" class="form-label">{{ entry_cost|escape('js') }}</label><input type="text" name="shipping_geozone_method[' + r + '][cost]" value="0" id="input-cost-' + r + '" class="form-control"/><div class="form-text">{{ help_cost|escape('js') }}</div><div id="error-cost-' + r + '" class="invalid-feedback"></div></div>';
    html += '<div class="mb-3"><label for="input-tax-class-' + r + '" class="form-label">{{ entry_tax_class|escape('js') }}</label><select name="shipping_geozone_method[' + r + '][tax_class_id]" id="input-tax-class-' + r + '" class="form-select"><option value="0">{{ text_none|escape('js') }}</option>{% for tax_class in tax_classes %}<option value="{{ tax_class.tax_class_id }}">{{ tax_class.title|escape('js') }}</option>{% endfor %}</select></div>';
    html += '</div><div class="col-md-1 text-end"><button type="button" onclick="$(\'#method-row-' + r + '\').remove();" class="btn btn-danger" aria-label="{{ button_remove|escape('js') }}"><i class="fa-solid fa-minus-circle" aria-hidden="true"></i></button></div></div></div>';

    $('#methods').append(html);
});
</script>
{{ footer }}
