<!DOCTYPE html>
<html dir="{{ direction }}" lang="{{ lang }}">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <title>{{ title }}</title>
  <base href="{{ base }}"/>
  {% if description %}
    <meta name="description" content="{{ description }}"/>
  {% endif %}
  {% if keywords %}
    <meta name="keywords" content="{{ keywords }}"/>
  {% endif %}
  <script src="{{ jquery }}" type="text/javascript"></script>
  <link href="{{ bootstrap }}" type="text/css" rel="stylesheet" media="screen"/>
  <link href="{{ icons }}" rel="stylesheet" type="text/css"/>
  <link href="{{ stylesheet }}" type="text/css" rel="stylesheet"/>
  <link href="{{ bcf_stylesheet }}" type="text/css" rel="stylesheet"/>
  <script src="catalog/view/javascript/common.js" type="text/javascript"></script>
  {% if icon %}
    <link rel="icon" href="{{ icon }}" type="image/png">
  {% endif %}
  {% for style in styles %}
    <link href="{{ style.href }}" type="text/css" rel="{{ style.rel }}" media="{{ style.media }}"/>
  {% endfor %}
  {% for script in scripts %}
    <script src="{{ script.href }}" type="text/javascript"></script>
  {% endfor %}
  {% for link in links %}
    <link href="{{ link.href }}" rel="{{ link.rel }}"/>
  {% endfor %}
  {% for analytic in analytics %}
    {{ analytic }}
  {% endfor %}
</head>
<body class="bcf">
<div id="container">
  <a href="#bcf-main" class="bcf-skip">{{ bcf_text_skip }}</a>
  <div id="alert"></div>
  <div class="bcf-topbar">
    <div class="container bcf-topbar-inner">
      {% if bcf_announcement %}<p class="bcf-topbar-message">{{ bcf_announcement }}</p>{% endif %}
      <ul class="bcf-topbar-list">
        {% if bcf_app_url and bcf_app_text %}
          <li class="d-none d-md-block"><a href="{{ bcf_app_url }}" rel="noopener">{{ bcf_app_text }}</a></li>
        {% endif %}
        {% if currency|trim %}<li>{{ currency }}</li>{% endif %}
        {% if language|trim %}<li>{{ language }}</li>{% endif %}
        <li>
          <div class="dropdown">
            <button type="button" class="bcf-topbar-toggle dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="fa-solid fa-user" aria-hidden="true"></i> <span class="d-none d-md-inline">{{ text_account }}</span></button>
            <ul class="dropdown-menu dropdown-menu-end">
              {% if not logged %}
                <li><a href="{{ register }}" class="dropdown-item">{{ text_register }}</a></li>
                <li><a href="{{ login }}" class="dropdown-item">{{ text_login }}</a></li>
              {% else %}
                <li><a href="{{ account }}" class="dropdown-item">{{ text_account }}</a></li>
                <li><a href="{{ order }}" class="dropdown-item">{{ text_order }}</a></li>
                <li><a href="{{ transaction }}" class="dropdown-item">{{ text_transaction }}</a></li>
                <li><a href="{{ download }}" class="dropdown-item">{{ text_download }}</a></li>
                <li><a href="{{ logout }}" class="dropdown-item">{{ text_logout }}</a></li>
              {% endif %}
              <li><hr class="dropdown-divider"></li>
              <li><a href="{{ checkout }}" class="dropdown-item">{{ text_checkout }}</a></li>
            </ul>
          </div>
        </li>
      </ul>
    </div>
  </div>
  <header class="bcf-header">
    <div class="container bcf-header-inner">
      <div class="bcf-header-start">
        {% if bcf_has_categories %}
          <button type="button" class="bcf-category-toggle" data-bs-toggle="offcanvas" data-bs-target="#bcf-category-drawer" aria-controls="bcf-category-drawer"><i class="fa-solid fa-bars-staggered" aria-hidden="true"></i> <span>{{ bcf_text_shop_by_category }}</span></button>
        {% endif %}
      </div>
      <div class="bcf-logo">
        {% if logo %}
          <a href="{{ home }}"><img src="{{ logo }}" title="{{ name }}" alt="{{ name }}" class="img-fluid"/></a>
        {% else %}
          <a href="{{ home }}" class="bcf-logo-text">{{ name }}</a>
        {% endif %}
      </div>
      <div class="bcf-header-end">
        <a href="{{ bcf_compare_url }}" class="bcf-icon-btn" title="{{ bcf_text_compare }}"><i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i><span class="visually-hidden">{{ bcf_text_compare }}</span>{% if bcf_compare_count %}<span class="bcf-badge">{{ bcf_compare_count }}</span>{% endif %}</a>
        <a href="{{ wishlist }}" id="wishlist-total" class="bcf-icon-btn" title="{{ text_wishlist }}"><i class="fa-regular fa-heart" aria-hidden="true"></i><span class="visually-hidden">{{ text_wishlist }}</span>{% if bcf_wishlist_count %}<span class="bcf-badge">{{ bcf_wishlist_count }}</span>{% endif %}</a>
        <div id="cart" class="bcf-cart">{{ cart }}</div>
      </div>
    </div>
  </header>
  <div class="bcf-navbar">
    <div class="container bcf-navbar-inner">
      {{ menu }}
      <div class="bcf-search">{{ search }}</div>
    </div>
  </div>
  <main id="bcf-main" tabindex="-1">
