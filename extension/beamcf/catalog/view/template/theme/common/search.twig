<form action="{{ action }}" method="post" class="bcf-search-form" role="search">
  <input type="text" name="search" value="{{ search }}" placeholder="{{ text_search }}" aria-label="{{ text_search }}" class="bcf-search-input"/>
  <button type="submit" class="bcf-search-btn" aria-label="{{ bcf_text_search }}"><i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i></button>
</form>
