{{ header }}
<div id="common-success" class="container bcf-success-page">
  <ul class="breadcrumb">
    {% for breadcrumb in breadcrumbs %}
      <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{% if loop.first %}<i class="fa-solid fa-house" aria-hidden="true"></i><span class="visually-hidden">{{ bcf_text_home }}</span>{% else %}{{ breadcrumb.text }}{% endif %}</a></li>
    {% endfor %}
  </ul>
  <div class="row">{{ column_left }}
    <div id="content" class="col">{{ content_top }}
      <section class="bcf-success-card" aria-labelledby="bcf-success-title">
        <div class="bcf-success-icon" aria-hidden="true"><i class="fa-solid fa-check"></i></div>
        <h1 id="bcf-success-title" class="bcf-success-title" tabindex="-1">{{ heading_title }}</h1>
        <div class="bcf-success-message">{{ text_message }}</div>
        <div class="bcf-success-actions">
          <a href="{{ continue }}" class="bcf-btn-checkout">{{ button_continue }}</a>
        </div>
      </section>
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>
{{ footer }}
