{{ header }}
<div id="product-info" class="container bcf-pd">
  <nav aria-label="breadcrumb">
    <ul class="breadcrumb">
      {% for breadcrumb in breadcrumbs %}
        <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{% if loop.first %}<i class="fa-solid fa-house" aria-hidden="true"></i><span class="visually-hidden">{{ bcf_text_home }}</span>{% else %}{{ breadcrumb.text }}{% endif %}</a></li>
      {% endfor %}
    </ul>
  </nav>
  <div class="row">{{ column_left }}
    <div id="content" class="col">
      {{ content_top }}
      <div class="bcf-pd-main">
        <div class="bcf-pd-media">
          {# One list for the stage and the thumbnails: the main image first (when set), then the gallery images. #}
          {% set items = [] %}
          {% if thumb %}{% set items = items|merge([{main: thumb, popup: popup, small: bcf_first_small}]) %}{% endif %}
          {% for image in images %}{% set items = items|merge([{main: image.bcf_main, popup: image.popup, small: image.thumb}]) %}{% endfor %}
          {% if items %}
            <div class="bcf-pd-stage bcf-qv-stage">
              {% if bcf_discount_percent %}<span class="bcf-badge-tag bcf-badge-sale bcf-pd-badge">-{{ bcf_discount_percent }}%</span>{% endif %}
              <button type="submit" form="form-wishlist" formaction="{{ wishlist_add }}" class="bcf-pd-heart" aria-label="{{ button_wishlist }}" title="{{ button_wishlist }}"><i class="fa-regular fa-heart" aria-hidden="true"></i></button>
              <a href="{{ items[0].popup }}" class="bcf-pd-zoom" data-bcf-zoom="{{ items[0].popup }}" aria-haspopup="dialog" title="{{ bcf_text_pd_zoom }}"><img src="{{ items[0].main }}" alt="{{ heading_title }}" id="bcf-pd-main" width="{{ bcf_thumb_width }}" height="{{ bcf_thumb_height }}" fetchpriority="high"/></a>
              {% if items|length > 1 %}
                <button type="button" class="bcf-qv-nav bcf-qv-prev" data-bcf-pd-step="-1" aria-label="{{ bcf_text_prev }}"><i class="fa-solid fa-chevron-left" aria-hidden="true"></i></button>
                <button type="button" class="bcf-qv-nav bcf-qv-next" data-bcf-pd-step="1" aria-label="{{ bcf_text_next }}"><i class="fa-solid fa-chevron-right" aria-hidden="true"></i></button>
              {% endif %}
            </div>
            {% if items|length > 1 %}
              <ul class="bcf-qv-thumbs list-unstyled" aria-label="{{ heading_title }}">
                {% for item in items %}
                  <li><button type="button" data-bcf-pd-image="{{ item.main }}" data-popup="{{ item.popup }}"{% if loop.first %} aria-current="true"{% endif %}><img src="{{ item.small }}" alt="{{ heading_title }} ({{ loop.index }}/{{ items|length }})" width="80" height="80"{% if not loop.first %} loading="lazy"{% endif %}/></button></li>
                {% endfor %}
              </ul>
            {% endif %}
          {% else %}
            <div class="bcf-pd-stage bcf-qv-stage bcf-qv-noimage"><i class="fa-regular fa-image" aria-hidden="true"></i></div>
          {% endif %}
        </div>

        <div class="bcf-pd-info">
          <h1 class="bcf-pd-name">{{ heading_title }}</h1>
          <div class="bcf-pd-head">
            {% if review_status %}
              <div class="bcf-rating bcf-pd-rating">
                {% if rating %}
                  {% for i in 1..5 %}
                    {% if rating < i %}
                      <span class="fa-stack" aria-hidden="true"><i class="fa-regular fa-star fa-stack-1x"></i></span>
                    {% else %}
                      <span class="fa-stack" aria-hidden="true"><i class="fa-solid fa-star fa-stack-1x"></i><i class="fa-regular fa-star fa-stack-1x"></i></span>
                    {% endif %}
                  {% endfor %}
                  <span class="bcf-pd-score">{{ rating }}/5</span>
                {% endif %}
                <a href="#tab-review" data-bcf-tab="tab-review">{{ text_reviews }}</a>
              </div>
            {% endif %}
            {% for product_code in product_codes %}<span class="bcf-pd-code"><strong>{{ product_code.code }}:</strong> {{ product_code.value }}</span>{% endfor %}
          </div>
          <div class="bcf-pd-brandrow">
            <ul class="bcf-qv-meta bcf-pd-meta list-unstyled">
              {% if manufacturer %}<li><strong>{{ text_manufacturer }}</strong> <a href="{{ manufacturers }}">{{ manufacturer }}</a></li>{% endif %}
              {% if model %}<li><strong>{{ text_model }}</strong> {{ model }}</li>{% endif %}
              {% if reward %}<li><strong>{{ text_reward }}</strong> {{ reward }}</li>{% endif %}
              <li><strong>{{ text_stock }}</strong> <span class="bcf-pd-stock {{ bcf_in_stock ? 'is-in' : 'is-out' }}">{{ stock }}</span></li>
            </ul>
            {% if bcf_brand_image %}<a href="{{ manufacturers }}" class="bcf-pd-brand"><img src="{{ bcf_brand_image }}" alt="{{ manufacturer }}" width="80" height="80" loading="lazy"/></a>{% endif %}
          </div>
          {% if price %}
            <div class="bcf-price bcf-pd-price">
              {% if not special %}
                <span class="price-new">{{ price }}</span>
              {% else %}
                <span class="price-new">{{ special }}</span> <span class="price-old">{{ price }}</span>
                {% if bcf_discount_percent %}<span class="bcf-pd-save">-{{ bcf_discount_percent }}%</span>{% endif %}
              {% endif %}
              {% if tax %}<span class="price-tax">{{ text_tax }} {{ tax }}</span>{% endif %}
              {% if points %}<span class="price-tax">{{ text_points }} {{ points }}</span>{% endif %}
            </div>
            {% if discounts %}
              <ul class="bcf-qv-discounts list-unstyled">
                {% for discount in discounts %}<li>{{ discount.quantity }}{{ text_discount }}{{ discount.price }}</li>{% endfor %}
              </ul>
            {% endif %}
          {% endif %}

          <div id="product">
            <form id="form-product" novalidate>
              {% if options %}
                {% for option in options %}
                  {% set oid = option.product_option_id %}
                  <div class="bcf-qv-field{% if option.required %} required{% endif %}">
                    {% if option.type == 'select' %}
                      <label for="input-option-{{ oid }}" class="form-label">{{ option.name }}</label>
                      <select name="option[{{ oid }}]" id="input-option-{{ oid }}" class="form-select"{% if option.required %} aria-required="true"{% endif %} aria-describedby="error-option-{{ oid }}">
                        <option value="">{{ text_select }}</option>
                        {% for value in option.product_option_value %}
                          <option value="{{ value.product_option_value_id }}">{{ value.name }}{% if value.price %} ({{ value.price_prefix }}{{ value.price }}){% endif %}</option>
                        {% endfor %}
                      </select>
                    {% elseif option.type == 'radio' or option.type == 'checkbox' %}
                      <fieldset id="input-option-{{ oid }}" aria-describedby="error-option-{{ oid }}">
                        <legend class="form-label">{{ option.name }}</legend>
                        {% for value in option.product_option_value %}
                          <div class="form-check">
                            <input type="{{ option.type }}" name="option[{{ oid }}]{% if option.type == 'checkbox' %}[]{% endif %}" value="{{ value.product_option_value_id }}" id="input-option-value-{{ value.product_option_value_id }}" class="form-check-input"/>
                            <label for="input-option-value-{{ value.product_option_value_id }}" class="form-check-label">
                              {% if value.image %}<img src="{{ value.image }}" alt="" class="img-thumbnail" width="50" height="50"/>{% endif %}
                              {{ value.name }}{% if value.price %} ({{ value.price_prefix }}{{ value.price }}){% endif %}</label>
                          </div>
                        {% endfor %}
                      </fieldset>
                    {% elseif option.type == 'text' %}
                      <label for="input-option-{{ oid }}" class="form-label">{{ option.name }}</label>
                      <input type="text" name="option[{{ oid }}]" value="{{ option.value }}" placeholder="{{ option.name }}" id="input-option-{{ oid }}" class="form-control" aria-describedby="error-option-{{ oid }}"/>
                    {% elseif option.type == 'textarea' %}
                      <label for="input-option-{{ oid }}" class="form-label">{{ option.name }}</label>
                      <textarea name="option[{{ oid }}]" rows="4" placeholder="{{ option.name }}" id="input-option-{{ oid }}" class="form-control" aria-describedby="error-option-{{ oid }}">{{ option.value }}</textarea>
                    {% elseif option.type == 'file' %}
                      <label for="button-upload-{{ oid }}" class="form-label">{{ option.name }}</label>
                      <div>
                        <button type="button" id="button-upload-{{ oid }}" data-oc-toggle="upload" data-oc-url="{{ upload }}" data-oc-target="#input-option-{{ oid }}" data-oc-size-max="{{ config_file_max_size }}" data-oc-size-error="{{ error_upload_size }}" class="btn btn-light"><i class="fa-solid fa-upload" aria-hidden="true"></i> {{ button_upload }}</button>
                        <input type="hidden" name="option[{{ oid }}]" value="" id="input-option-{{ oid }}"/>
                      </div>
                    {% elseif option.type == 'date' or option.type == 'time' or option.type == 'datetime' %}
                      <label for="input-option-{{ oid }}" class="form-label">{{ option.name }}</label>
                      <input type="{{ option.type == 'datetime' ? 'datetime-local' : option.type }}" name="option[{{ oid }}]" value="{{ option.value }}" id="input-option-{{ oid }}" class="form-control" aria-describedby="error-option-{{ oid }}"/>
                    {% endif %}
                    <div id="error-option-{{ oid }}" class="invalid-feedback"></div>
                  </div>
                {% endfor %}
              {% endif %}

              {% if subscription_plans %}
                <div class="bcf-qv-field required">
                  <label for="input-subscription" class="form-label">{{ text_subscription }}</label>
                  <select name="subscription_plan_id" id="input-subscription" class="form-select" aria-required="true" aria-describedby="error-subscription">
                    <option value="">{{ text_select }}</option>
                    {% for plan in subscription_plans %}
                      <option value="{{ plan.subscription_plan_id }}">{{ plan.name }}</option>
                    {% endfor %}
                  </select>
                  {% for plan in subscription_plans %}
                    <div id="subscription-description-{{ plan.subscription_plan_id }}" class="form-text subscription d-none">{{ plan.description }}</div>
                  {% endfor %}
                  <div id="error-subscription" class="invalid-feedback"></div>
                </div>
              {% endif %}

              {% if minimum > 1 %}<p class="bcf-qv-min"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ text_minimum }}</p>{% endif %}

              <div class="bcf-qv-buy">
                <div class="bcf-qv-qty">
                  <button type="button" data-bcf-pd-qty="-1" aria-label="{{ bcf_text_qty_less }}">&minus;</button>
                  <input type="text" inputmode="numeric" name="quantity" value="{{ minimum }}" id="input-quantity" data-min="{{ minimum }}" aria-label="{{ entry_qty }}" aria-describedby="error-quantity" autocomplete="off"/>
                  <button type="button" data-bcf-pd-qty="1" aria-label="{{ bcf_text_qty_more }}">+</button>
                </div>
                <button type="submit" class="bcf-qv-add" id="button-cart"><span>{{ button_cart }}</span></button>
                <button type="submit" class="bcf-pd-buy" id="button-buy" data-bcf-buy>{{ bcf_text_pd_buy_now }}</button>
              </div>
              <div id="error-quantity" class="invalid-feedback"></div>
              <input type="hidden" name="product_id" value="{{ product_id }}" id="input-product-id"/>
              <button type="submit" form="form-wishlist" formaction="{{ compare_add }}" class="bcf-pd-action bcf-pd-compare"><i class="fa-solid fa-arrows-rotate" aria-hidden="true"></i> {{ bcf_text_pd_compare }}</button>
            </form>
            <div id="bcf-pd-status" class="bcf-qv-status" role="status" aria-live="polite"></div>
            <form method="post" id="form-wishlist" data-oc-toggle="ajax"><input type="hidden" name="product_id" value="{{ product_id }}"/></form>
          </div>
          {% if review_status %}
            <section id="tab-review" class="bcf-pd-reviews" tabindex="-1" aria-labelledby="bcf-pd-reviews-title">
              <h2 id="bcf-pd-reviews-title" class="bcf-pd-reviews-title">{{ rating ? rating ~ '/5' : '' }} <small>{{ text_reviews }}</small></h2>
              {{ review }}
            </section>
          {% endif %}
        </div>

      <div class="bcf-pd-tabs">
        <ul class="nav nav-tabs" role="tablist">
          <li class="nav-item" role="presentation"><button type="button" class="nav-link active" id="tab-description-btn" data-bs-toggle="tab" data-bs-target="#tab-description" role="tab" aria-controls="tab-description" aria-selected="true">{{ tab_description }}</button></li>
          {% if attribute_groups %}
            <li class="nav-item" role="presentation"><button type="button" class="nav-link" id="tab-specification-btn" data-bs-toggle="tab" data-bs-target="#tab-specification" role="tab" aria-controls="tab-specification" aria-selected="false">{{ tab_attribute }}</button></li>
          {% endif %}
        </ul>
        <div class="tab-content">
          <div id="tab-description" class="tab-pane fade show active" role="tabpanel" aria-labelledby="tab-description-btn" tabindex="0">{{ description }}
            {% if tags %}
              <p class="bcf-pd-tags">{{ text_tags }}
                {% for tag in tags %}<a href="{{ tag.href }}">{{ tag.tag }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
              </p>
            {% endif %}
          </div>
          {% if attribute_groups %}
            <div id="tab-specification" class="tab-pane fade" role="tabpanel" aria-labelledby="tab-specification-btn" tabindex="0">
              <div class="table-responsive">
                <table class="table table-bordered">
                  {% for attribute_group in attribute_groups %}
                    <thead><tr><th colspan="2" scope="colgroup">{{ attribute_group.name }}</th></tr></thead>
                    <tbody>
                      {% for attribute in attribute_group.attribute %}
                        <tr><th scope="row">{{ attribute.name }}</th><td>{{ attribute.text }}</td></tr>
                      {% endfor %}
                    </tbody>
                  {% endfor %}
                </table>
              </div>
            </div>
          {% endif %}
        </div>
      </div>
      </div>
      {{ related }}
      {{ content_bottom }}
    </div>
    {{ column_right }}
  </div>
</div>

<dialog id="bcf-zoom" class="bcf-zoom" aria-label="{{ heading_title }}">
  <form method="dialog"><button class="bcf-qv-close" aria-label="{{ bcf_text_close }}"><i class="fa-solid fa-xmark" aria-hidden="true"></i></button></form>
  <img src="" alt="{{ heading_title }}" id="bcf-zoom-img"/>
</dialog>

<script type="text/javascript"><!--
$('#input-subscription').on('change', function () {
    $('.subscription').addClass('d-none');
    $('#subscription-description-' + $(this).val()).removeClass('d-none');
});
//--></script>
<script type="text/javascript"><!--
window.bcfProduct = {cart: 'index.php?route=checkout/cart.add&language={{ language }}', checkout: {{ bcf_checkout|json_encode|raw }}, cartInfo: 'index.php?route=common/cart.info&language={{ language }}', failed: {{ bcf_text_qv_failed|json_encode|raw }}};
//--></script>
<script src="extension/beamcf/catalog/view/javascript/product.js" type="text/javascript"></script>
{{ footer }}
