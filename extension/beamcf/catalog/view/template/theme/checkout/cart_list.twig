{% if products %}
  {% if error_warning %}
    <div class="alert alert-danger alert-dismissible" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{ error_warning }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if error_stock %}
    <div class="alert alert-danger alert-dismissible" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i> {{ error_stock }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if success %}
    <div class="alert alert-success alert-dismissible" role="status"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> {{ success }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  {% if attention %}
    <div class="alert alert-info"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> {{ attention }} <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
  {% endif %}
  <h1 class="bcf-page-title">{{ heading_title }}{% if weight %} <small class="bcf-cart-weight">({{ weight }})</small>{% endif %}</h1>
  <div id="output-cart" class="bcf-cart-tablewrap">
    <table class="bcf-cart-grid">
      <thead>
        <tr>
          <th class="text-center">{{ column_image }}</th>
          <th>{{ column_name }}</th>
          <th>{{ text_model }}</th>
          <th>{{ column_quantity }}</th>
          <th class="text-end">{{ column_price }}</th>
          <th class="text-end">{{ column_total }}</th>
        </tr>
      </thead>
      <tbody>
        {% for product in products %}
          <tr>
            <td class="bcf-cart-img">{% if product.thumb %}<a href="{{ product.href }}"><img src="{{ product.thumb }}" alt="{{ product.name }}" width="76" height="94"/></a>{% endif %}</td>
            <td class="bcf-cart-name-cell" data-label="{{ column_name }}">
              <a href="{{ product.href }}">{{ product.name }}</a>{% if not product.stock %} <span class="text-danger" title="{{ error_stock }}">***</span>{% endif %}
              {% if product.option or product.subscription or product.reward %}
                <ul class="list-unstyled bcf-cart-row-meta">
                  {% for option in product.option %}
                    <li>{{ option.name }}: {{ option.value }}</li>
                  {% endfor %}
                  {% if product.subscription %}
                    <li>{{ text_subscription }}: {{ product.subscription }}</li>
                  {% endif %}
                  {% if product.reward %}
                    <li>{{ text_points }}: {{ product.reward }}</li>
                  {% endif %}
                </ul>
              {% endif %}
            </td>
            <td data-label="{{ text_model }}">{{ product.model }}</td>
            <td class="bcf-cart-qty-cell" data-label="{{ column_quantity }}">
              <form method="post" data-oc-target="#shopping-cart">
                <div class="input-group">
                  <input type="text" name="quantity" value="{{ product.quantity }}" size="2" inputmode="numeric" aria-label="{{ column_quantity }}: {{ product.name }}" class="form-control{% if product.minimum %} is-invalid{% endif %}"/>
                  <input type="hidden" name="key" value="{{ product.cart_id }}"/>
                  <button type="submit" formaction="{{ edit }}" title="{{ button_update }}" aria-label="{{ button_update }}: {{ product.name }}" class="bcf-cart-update"><i class="fa-solid fa-rotate" aria-hidden="true"></i></button>
                  <a href="{{ product.remove }}" title="{{ button_remove }}" aria-label="{{ button_remove }}: {{ product.name }}" class="bcf-cart-row-remove"><i class="fa-solid fa-circle-xmark" aria-hidden="true"></i></a>
                </div>
              </form>
              {% if product.minimum %}
                <small class="invalid-feedback d-block">{{ product.minimum }}</small>
              {% endif %}
            </td>
            <td class="text-end" data-label="{{ column_price }}">{{ product.price }}</td>
            <td class="text-end" data-label="{{ column_total }}">{{ product.total }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>

  <div class="bcf-cart-lower">
    <div class="bcf-cart-modules-col">
      {% if modules %}
        <h2 class="bcf-cart-next">{{ text_next }}</h2>
        <p class="bcf-cart-next-help">{{ text_next_choice }}</p>
        <div id="accordion" class="accordion bcf-cart-modules">
          {% for module in modules %}
            {{ module }}
          {% endfor %}
        </div>
      {% endif %}
    </div>
    <table id="checkout-total" class="bcf-cart-totals-table">
      <tbody>
        {% for total in totals %}
          <tr>
            <th scope="row">{{ total.title }}:</th>
            <td>{{ total.text }}</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  <div class="bcf-cart-buttons">
    <a href="{{ continue }}" class="bcf-btn-continue">{{ button_shopping }}</a>
    <a href="{{ checkout }}" class="bcf-btn-checkout">{{ button_checkout }}</a>
  </div>
{% else %}
  <div class="bcf-cart-emptystate">
    <i class="fa-solid fa-bag-shopping" aria-hidden="true"></i>
    <h1 class="bcf-page-title">{{ heading_title }}</h1>
    <p>{{ text_no_results }}</p>
    <a href="{{ continue }}" class="bcf-btn-checkout">{{ button_continue }}</a>
  </div>
{% endif %}
