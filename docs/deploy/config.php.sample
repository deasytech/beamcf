<?php
// Copy to config.php in the site root on the server and replace every CHANGE_ME / yourdomain value.
define('APPLICATION', 'Catalog');

define('HTTP_SERVER', 'https://yourdomain.com/');

// cPanel home is /home/CPANELUSER ; the site root is usually /home/CPANELUSER/public_html/
define('DIR_OPENCART', '/home/CPANELUSER/public_html/');
define('DIR_APPLICATION', DIR_OPENCART . 'catalog/');
define('DIR_EXTENSION', DIR_OPENCART . 'extension/');
define('DIR_IMAGE', DIR_OPENCART . 'image/');
define('DIR_SYSTEM', DIR_OPENCART . 'system/');
// Outside public_html, so it is never web-accessible.
define('DIR_STORAGE', '/home/CPANELUSER/storage/');
define('DIR_LANGUAGE', DIR_APPLICATION . 'language/');
define('DIR_TEMPLATE', DIR_APPLICATION . 'view/template/');
define('DIR_CONFIG', DIR_SYSTEM . 'config/');
define('DIR_CACHE', DIR_STORAGE . 'cache/');
define('DIR_DOWNLOAD', DIR_STORAGE . 'download/');
define('DIR_LOGS', DIR_STORAGE . 'logs/');
define('DIR_SESSION', DIR_STORAGE . 'session/');
define('DIR_UPLOAD', DIR_STORAGE . 'upload/');

define('DB_DRIVER', 'mysqli');
define('DB_HOSTNAME', 'localhost');
define('DB_USERNAME', 'CPANELUSER_dbuser');
define('DB_PASSWORD', 'CHANGE_ME');
define('DB_DATABASE', 'CPANELUSER_dbname');
define('DB_PORT', '3306');
define('DB_PREFIX', '');
define('DB_SSL_KEY', '');
define('DB_SSL_CERT', '');
